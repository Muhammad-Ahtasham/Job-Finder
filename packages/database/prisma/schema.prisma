// Phase 1: identity + tenancy. Phase 2: search projects + company discovery.
// Phase 3: company website enrichment (bottom of file).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  /// Always stored lowercase + trimmed (normalized in the application layer).
  email        String   @unique
  name         String
  /// Argon2id PHC string. Never returned by any API.
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships            WorkspaceMember[]
  sessions               Session[]
  personalWorkspace      Workspace?        @relation("PersonalWorkspaceOwner")
  createdProjects        SearchProject[]   @relation("ProjectCreator")
  requestedRuns          SearchRun[]       @relation("RunRequester")
  resolvedReviews        MatchReview[]     @relation("ReviewResolver")
  requestedEnrichments   ExtractionRun[]   @relation("ExtractionRequester")
  resolvedCompanyReviews CompanyReview[]   @relation("CompanyReviewResolver")
  requestedJobRuns       JobRun[]          @relation("JobRunRequester")

  @@map("users")
}

model Workspace {
  id              String   @id @default(uuid(7)) @db.Uuid
  name            String
  slug            String   @unique
  isPersonal      Boolean  @default(false) @map("is_personal")
  /// Set only for personal workspaces; UNIQUE guarantees at most one per user.
  personalOwnerId String?  @unique @map("personal_owner_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  personalOwner   User?             @relation("PersonalWorkspaceOwner", fields: [personalOwnerId], references: [id], onDelete: Cascade)
  members         WorkspaceMember[]
  projects        SearchProject[]
  runs            SearchRun[]
  companies       Company[]
  reviews         MatchReview[]
  extractionRuns  ExtractionRun[]
  companyPages    CompanyPage[]
  companyContacts CompanyContact[]
  companyReviews  CompanyReview[]
  jobRuns         JobRun[]
  jobSources      JobSource[]
  jobs            Job[]
  jobChecks       JobCheck[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid(7)) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

/// Server-side session. The raw token only ever exists in the client's cookie;
/// we store its SHA-256 so a database leak does not yield usable sessions.
model Session {
  id                 String    @id @default(uuid(7)) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  tokenHash          String    @unique @map("token_hash")
  /// Previous token, honoured briefly after rotation so parallel requests don't 401.
  previousTokenHash  String?   @map("previous_token_hash")
  previousValidUntil DateTime? @map("previous_valid_until")
  createdAt          DateTime  @default(now()) @map("created_at")
  lastSeenAt         DateTime  @default(now()) @map("last_seen_at")
  rotatedAt          DateTime  @default(now()) @map("rotated_at")
  /// Absolute expiry; the session is dead after this regardless of activity.
  expiresAt          DateTime  @map("expires_at")
  userAgent          String?   @map("user_agent")
  ip                 String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([previousTokenHash])
  @@map("sessions")
}

// ============================================================================
// Phase 2: search projects and company discovery
//
// Company data is WORKSPACE-SCOPED (see docs/adr/0003): provider-derived data is licensed to
// the account that fetched it and must not be shown to other tenants, and workspace isolation
// then holds by construction. A shared canonical layer can reference these rows later.
// ============================================================================

enum RunStatus {
  QUEUED
  RUNNING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

enum TaskStatus {
  QUEUED
  RUNNING
  RETRYING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AttemptOutcome {
  SUCCESS
  RETRYABLE_ERROR
  FATAL_ERROR
  CANCELLED
}

/// MISSING = nothing known · UNVERIFIED = reported by a source, unchecked · VERIFIED · FAILED
enum FieldStatus {
  MISSING
  UNVERIFIED
  VERIFIED
  FAILED
}

enum CompanyStatus {
  ACTIVE
  MERGED
}

enum IdentityType {
  DOMAIN
  PROVIDER_ID
  REGISTRATION_NUMBER
}

enum DiscoveryOutcome {
  CREATED
  MATCHED
  REVIEW_REQUIRED
}

enum ReviewStatus {
  PENDING
  MERGED
  DISMISSED
}

model SearchProject {
  id           String   @id @default(uuid(7)) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  createdById  String?  @map("created_by_id") @db.Uuid
  name         String
  /// ISO 3166-1 alpha-2
  country      String   @default("PK")
  city         String
  industry     String
  keywords     String[]
  targetRoles  String[] @default([]) @map("target_roles")
  targetSkills String[] @default([]) @map("target_skills")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?       @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  runs      SearchRun[]

  @@unique([workspaceId, name])
  @@index([workspaceId, createdAt])
  @@map("search_projects")
}

model SearchRun {
  id                String    @id @default(uuid(7)) @db.Uuid
  projectId         String    @map("project_id") @db.Uuid
  /// Denormalized so every query can be workspace-scoped without a join.
  workspaceId       String    @map("workspace_id") @db.Uuid
  requestedById     String?   @map("requested_by_id") @db.Uuid
  status            RunStatus @default(QUEUED)
  /// Immutable copy of what was searched (keywords, city, providers) at start time.
  config            Json
  /// Client-supplied Idempotency-Key: the same key returns the same run.
  idempotencyKey    String?   @map("idempotency_key")
  createdAt         DateTime  @default(now()) @map("created_at")
  startedAt         DateTime? @map("started_at")
  finishedAt        DateTime? @map("finished_at")
  cancelRequestedAt DateTime? @map("cancel_requested_at")
  plannedAt         DateTime? @map("planned_at")

  // Persisted statistics, updated in the same transaction as the records they describe.
  candidatesFound    Int @default(0) @map("candidates_found")
  candidatesFiltered Int @default(0) @map("candidates_filtered")
  companiesCreated   Int @default(0) @map("companies_created")
  companiesMatched   Int @default(0) @map("companies_matched")
  reviewsCreated     Int @default(0) @map("reviews_created")
  duplicatesSkipped  Int @default(0) @map("duplicates_skipped")
  rejected           Int @default(0)

  project     SearchProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestedBy User?             @relation("RunRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  tasks       DiscoveryTask[]
  results     DiscoveryResult[]

  @@unique([projectId, idempotencyKey])
  @@index([projectId, createdAt])
  @@index([workspaceId, status])
  @@index([status, createdAt])
  @@map("search_runs")
}

/// One unit of provider work (provider x query). The durable source of truth for progress;
/// BullMQ only delivers it.
model DiscoveryTask {
  id                 String     @id @default(uuid(7)) @db.Uuid
  runId              String     @map("run_id") @db.Uuid
  providerId         String     @map("provider_id")
  /// Stable per (run, provider): makes planning idempotent.
  queryKey           String     @map("query_key")
  kind               String
  keyword            String?
  status             TaskStatus @default(QUEUED)
  attempts           Int        @default(0)
  maxAttempts        Int        @default(5) @map("max_attempts")
  /// Provider pagination cursor; lets a retry resume instead of restarting.
  cursor             String?
  pagesFetched       Int        @default(0) @map("pages_fetched")
  candidatesFound    Int        @default(0) @map("candidates_found")
  lastErrorCode      String?    @map("last_error_code")
  lastErrorMessage   String?    @map("last_error_message")
  lastErrorRetryable Boolean?   @map("last_error_retryable")
  lastErrorAt        DateTime?  @map("last_error_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  startedAt          DateTime?  @map("started_at")
  finishedAt         DateTime?  @map("finished_at")

  run        SearchRun              @relation(fields: [runId], references: [id], onDelete: Cascade)
  attemptLog DiscoveryTaskAttempt[]
  results    DiscoveryResult[]

  @@unique([runId, providerId, queryKey])
  @@index([runId, status])
  @@index([status, updatedAt])
  @@map("discovery_tasks")
}

/// Provider error tracking: one row per execution attempt.
model DiscoveryTaskAttempt {
  id           String         @id @default(uuid(7)) @db.Uuid
  taskId       String         @map("task_id") @db.Uuid
  attemptNo    Int            @map("attempt_no")
  outcome      AttemptOutcome
  errorCode    String?        @map("error_code")
  errorMessage String?        @map("error_message")
  httpStatus   Int?           @map("http_status")
  retryAfterMs Int?           @map("retry_after_ms")
  startedAt    DateTime       @default(now()) @map("started_at")
  finishedAt   DateTime?      @map("finished_at")

  task DiscoveryTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("discovery_task_attempts")
}

model Company {
  id             String        @id @default(uuid(7)) @db.Uuid
  workspaceId    String        @map("workspace_id") @db.Uuid
  displayName    String        @map("display_name")
  /// Folded name without legal suffixes: blocking/matching key.
  nameKey        String        @map("name_key")
  coreName       String        @map("core_name")
  nameTokens     String[]      @map("name_tokens")
  coreTokens     String[]      @map("core_tokens")
  country        String
  city           String?
  website        String?
  /// Registrable domain of `website` (never an aggregator domain).
  domain         String?
  description    String?
  // Verification statuses instead of dropping incomplete companies.
  websiteStatus  FieldStatus   @default(MISSING) @map("website_status")
  emailStatus    FieldStatus   @default(MISSING) @map("email_status")
  careersStatus  FieldStatus   @default(MISSING) @map("careers_status")
  status         CompanyStatus @default(ACTIVE)
  mergedIntoId   String?       @map("merged_into_id") @db.Uuid
  /// Phase 3: last time website enrichment finished without a fatal error.
  lastEnrichedAt DateTime?     @map("last_enriched_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  workspace          Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mergedInto         Company?          @relation("CompanyMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom         Company[]         @relation("CompanyMerge")
  sources            CompanySource[]
  locations          CompanyLocation[]
  aliases            CompanyAlias[]
  identities         CompanyIdentity[]
  results            DiscoveryResult[]
  reviewsAsCandidate MatchReview[]     @relation("ReviewCandidate")
  reviewsAsExisting  MatchReview[]     @relation("ReviewExisting")
  pages              CompanyPage[]
  contacts           CompanyContact[]
  extractionRuns     ExtractionRun[]
  companyReviews     CompanyReview[]
  jobRuns            JobRun[]
  jobSources         JobSource[]
  jobs               Job[]

  @@index([workspaceId, status, id])
  @@index([workspaceId, nameKey])
  @@index([nameTokens], type: Gin)
  @@map("companies")
}

/// Provenance: which provider reported a company, where, when, and under what licence.
model CompanySource {
  id             String    @id @default(uuid(7)) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  providerId     String    @map("provider_id")
  /// Deterministic per-provider key (external id, domain or name+city): idempotent upsert.
  sourceKey      String    @map("source_key")
  externalId     String?   @map("external_id")
  sourceUrl      String?   @map("source_url")
  rawName        String    @map("raw_name")
  nameConfidence String    @default("HIGH") @map("name_confidence")
  matchedKeyword String?   @map("matched_keyword")
  /// Provider payload subset. Nulled by the purge job when the provider's storage terms expire.
  rawData        Json?     @map("raw_data")
  attribution    String?
  retrievedAt    DateTime  @map("retrieved_at")
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at")
  expiresAt      DateTime? @map("expires_at")
  sightings      Int       @default(1)

  company Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  results DiscoveryResult[]

  @@unique([workspaceId, providerId, sourceKey])
  @@index([companyId])
  @@index([expiresAt])
  @@map("company_sources")
}

model CompanyLocation {
  id            String   @id @default(uuid(7)) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  /// Hash of normalized city + address tokens: prevents duplicate locations.
  locationKey   String   @map("location_key")
  city          String?
  cityKey       String?  @map("city_key")
  country       String
  addressRaw    String?  @map("address_raw")
  addressTokens String[] @default([]) @map("address_tokens")
  lat           Float?
  lng           Float?
  phones        String[] @default([])
  sourceId      String?  @map("source_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, locationKey])
  @@index([companyId])
  @@map("company_locations")
}

model CompanyAlias {
  id        String   @id @default(uuid(7)) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  alias     String
  aliasKey  String   @map("alias_key")
  sourceId  String?  @map("source_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, aliasKey])
  @@map("company_aliases")
}

/// The deterministic matching index. The unique constraint is the database-level guarantee
/// that one domain / provider id / registration number maps to at most one company per workspace.
model CompanyIdentity {
  id          String       @id @default(uuid(7)) @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  type        IdentityType
  /// "" for DOMAIN, provider id for PROVIDER_ID, scheme (NTN, VATIN, ...) for REGISTRATION_NUMBER.
  scope       String       @default("")
  value       String
  createdAt   DateTime     @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, type, scope, value])
  @@index([companyId])
  @@map("company_identities")
}

model DiscoveryResult {
  id              String           @id @default(uuid(7)) @db.Uuid
  runId           String           @map("run_id") @db.Uuid
  workspaceId     String           @map("workspace_id") @db.Uuid
  taskId          String?          @map("task_id") @db.Uuid
  companyId       String           @map("company_id") @db.Uuid
  companySourceId String           @map("company_source_id") @db.Uuid
  providerId      String           @map("provider_id")
  /// Same key as CompanySource.sourceKey: one result per (run, provider, hit); replays are no-ops.
  sourceKey       String           @map("source_key")
  outcome         DiscoveryOutcome
  matchScore      Float?           @map("match_score")
  matchReasons    Json             @default("[]") @map("match_reasons")
  keywords        String[]         @default([])
  createdAt       DateTime         @default(now()) @map("created_at")

  run     SearchRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  task    DiscoveryTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source  CompanySource  @relation(fields: [companySourceId], references: [id], onDelete: Cascade)

  @@unique([runId, providerId, sourceKey])
  @@index([runId, id])
  @@index([companyId])
  @@index([workspaceId])
  @@map("discovery_results")
}

/// An ambiguous match awaiting a human decision. The candidate is kept as its own company.
model MatchReview {
  id                 String       @id @default(uuid(7)) @db.Uuid
  workspaceId        String       @map("workspace_id") @db.Uuid
  candidateCompanyId String       @map("candidate_company_id") @db.Uuid
  existingCompanyId  String       @map("existing_company_id") @db.Uuid
  /// Sorted "a:b" ids: one review per unordered pair, and a DISMISSED pair is never re-raised.
  pairKey            String       @map("pair_key")
  score              Float
  reasons            Json
  status             ReviewStatus @default(PENDING)
  runId              String?      @map("run_id") @db.Uuid
  resolvedById       String?      @map("resolved_by_id") @db.Uuid
  resolvedAt         DateTime?    @map("resolved_at")
  createdAt          DateTime     @default(now()) @map("created_at")

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  candidate  Company   @relation("ReviewCandidate", fields: [candidateCompanyId], references: [id], onDelete: Cascade)
  existing   Company   @relation("ReviewExisting", fields: [existingCompanyId], references: [id], onDelete: Cascade)
  resolvedBy User?     @relation("ReviewResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, pairKey])
  @@index([workspaceId, status, id])
  @@map("match_reviews")
}

// ============================================================================
// Phase 3: company website enrichment
//
// Pages, contacts and verification decisions are kept with their evidence. Raw page bodies
// are NOT stored (only a hash of the visible text), and nothing here claims that a mailbox
// exists: VERIFIED on a contact means "published on the verified official website".
// ============================================================================

enum ExtractionStatus {
  QUEUED
  RUNNING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum PageType {
  HOMEPAGE
  ABOUT
  CONTACT
  CAREERS
  JOBS
  TEAM
  OTHER
}

enum PageFetchStatus {
  /// Known from a link but deliberately not fetched (e.g. an external job board).
  DISCOVERED
  FETCHED
  BLOCKED_ROBOTS
  BLOCKED_UNSAFE
  FAILED
}

enum ContactKind {
  EMAIL
  LINKEDIN
}

enum EmailCategory {
  HR
  CAREERS
  RECRUITMENT
  GENERAL
  OTHER
}

enum ClassifiedBy {
  RULES
  AI
}

enum CompanyReviewKind {
  WEBSITE
}

enum CompanyReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WebsiteDecision {
  OFFICIAL
  REJECTED
  UNCERTAIN
}

/// One enrichment attempt for one company: the durable record of what was crawled and what failed.
model ExtractionRun {
  id            String           @id @default(uuid(7)) @db.Uuid
  workspaceId   String           @map("workspace_id") @db.Uuid
  companyId     String           @map("company_id") @db.Uuid
  requestedById String?          @map("requested_by_id") @db.Uuid
  status        ExtractionStatus @default(QUEUED)
  /// = companyId while QUEUED/RUNNING, NULL once finished. UNIQUE makes "one active run per company" a
  /// database guarantee (NULLs do not collide), so concurrent POST /enrich calls share one run.
  activeKey     String?          @unique @map("active_key") @db.Uuid
  attempts      Int              @default(0)
  /// The website that was crawled, if one was accepted.
  websiteUrl    String?          @map("website_url")
  pagesFound    Int              @default(0) @map("pages_found")
  contactsFound Int              @default(0) @map("contacts_found")
  /// Crawl counters: requests, pagesFetched, blockedByRobots, blockedUnsafe, failed, aiCalls.
  stats         Json             @default("{}")
  errorCode     String?          @map("error_code")
  errorMessage  String?          @map("error_message")
  /// Every tracked failure of the run ({code, message, retryable}); capped.
  errors        Json             @default("[]")
  createdAt     DateTime         @default(now()) @map("created_at")
  startedAt     DateTime?        @map("started_at")
  finishedAt    DateTime?        @map("finished_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestedBy User?     @relation("ExtractionRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([status, createdAt])
  @@map("extraction_runs")
}

model CompanyPage {
  id             String          @id @default(uuid(7)) @db.Uuid
  companyId      String          @map("company_id") @db.Uuid
  workspaceId    String          @map("workspace_id") @db.Uuid
  /// Canonical URL (no fragment / tracking params): one row per page per company.
  url            String
  type           PageType
  typeConfidence Float           @map("type_confidence")
  classifiedBy   ClassifiedBy    @default(RULES) @map("classified_by")
  title          String?
  fetchStatus    PageFetchStatus @map("fetch_status")
  httpStatus     Int?            @map("http_status")
  contentType    String?         @map("content_type")
  /// SHA-256 of the visible text: detects change without storing the page.
  contentHash    String?         @map("content_hash")
  errorCode      String?         @map("error_code")
  discoveredFrom String?         @map("discovered_from")
  depth          Int             @default(0)
  /// On another registrable domain (an ATS job board): linked, never crawled.
  external       Boolean         @default(false)
  fetchedAt      DateTime?       @map("fetched_at")
  firstSeenAt    DateTime        @default(now()) @map("first_seen_at")
  lastSeenAt     DateTime        @default(now()) @map("last_seen_at")
  lastRunId      String?         @map("last_run_id") @db.Uuid

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts  CompanyContact[]

  @@unique([companyId, url])
  @@index([companyId, type])
  @@index([workspaceId])
  @@map("company_pages")
}

/// A publicly published e-mail address or LinkedIn company URL, with where and when it was found.
model CompanyContact {
  id                 String         @id @default(uuid(7)) @db.Uuid
  companyId          String         @map("company_id") @db.Uuid
  workspaceId        String         @map("workspace_id") @db.Uuid
  kind               ContactKind
  /// Lower-cased address / canonical LinkedIn company URL.
  value              String
  category           EmailCategory?
  classifiedBy       ClassifiedBy   @default(RULES) @map("classified_by")
  confidence         Float
  /// VERIFIED = published on the verified official website. NEVER "the mailbox exists".
  verificationStatus FieldStatus    @map("verification_status")
  verificationMethod String         @map("verification_method")
  extractionMethod   String         @map("extraction_method")
  /// Always present: every contact is traceable to a page.
  sourceUrl          String         @map("source_url")
  sourcePageId       String?        @map("source_page_id") @db.Uuid
  /// Short quote around the value, for reviewers.
  context            String?
  domainMatch        Boolean?       @map("domain_match")
  /// First time this value was extracted; later runs only move lastSeenAt.
  extractedAt        DateTime       @map("extracted_at")
  lastSeenAt         DateTime       @map("last_seen_at")
  lastRunId          String?        @map("last_run_id") @db.Uuid

  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace  Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourcePage CompanyPage? @relation(fields: [sourcePageId], references: [id], onDelete: SetNull)

  @@unique([companyId, kind, value])
  @@index([companyId, kind])
  @@index([workspaceId])
  @@map("company_contacts")
}

/// A decision about a candidate website, with its evidence.
/// APPROVED/REJECTED without `decidedManually` is an automatic decision; PENDING needs a human.
/// A decision a person made is never overwritten or re-proposed by later enrichment runs.
model CompanyReview {
  id              String              @id @default(uuid(7)) @db.Uuid
  workspaceId     String              @map("workspace_id") @db.Uuid
  companyId       String              @map("company_id") @db.Uuid
  kind            CompanyReviewKind   @default(WEBSITE)
  /// Registrable domain of the candidate: one review per (company, kind, domain).
  subjectKey      String              @map("subject_key")
  subjectUrl      String              @map("subject_url")
  decision        WebsiteDecision
  confidence      Float
  /// Evidence[]: {signal, detail, weight, url?}
  evidence        Json
  status          CompanyReviewStatus @default(PENDING)
  decidedManually Boolean             @default(false) @map("decided_manually")
  runId           String?             @map("run_id") @db.Uuid
  resolvedById    String?             @map("resolved_by_id") @db.Uuid
  resolvedAt      DateTime?           @map("resolved_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  resolvedBy User?     @relation("CompanyReviewResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([companyId, kind, subjectKey])
  @@index([workspaceId, status])
  @@map("company_reviews")
}

// ============================================================================
// Phase 4: career page discovery and job provider integrations
//
// A JobSource is one place a company publishes jobs (a Greenhouse/Lever/Ashby board or a generic
// career page). Every fetch of a source is recorded as a JobCheck whose outcome distinguishes
// "found jobs" from "the source says there are none" from "we could not tell" — a failed or
// inconclusive check never closes a job and never means zero vacancies.
// ============================================================================

enum JobSourceStatus {
  ACTIVE
  /// An ATS we recognise but have no adapter for: recorded, never scraped.
  UNSUPPORTED
  DISABLED
}

enum JobCheckOutcome {
  /// Jobs were found.
  JOBS
  /// The source positively reported zero openings.
  NO_OPENINGS
  /// A page was read but nothing could be extracted: unknown, NOT zero.
  INCONCLUSIVE
  /// The request failed: unknown, NOT zero.
  FAILED
}

enum JobStatus {
  OPEN
  CLOSED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
  OTHER
  UNKNOWN
}

enum WorkplaceType {
  ONSITE
  REMOTE
  HYBRID
  UNKNOWN
}

/// One job-discovery attempt for one company (find career pages → detect ATS → fetch jobs).
model JobRun {
  id               String           @id @default(uuid(7)) @db.Uuid
  workspaceId      String           @map("workspace_id") @db.Uuid
  companyId        String           @map("company_id") @db.Uuid
  requestedById    String?          @map("requested_by_id") @db.Uuid
  status           ExtractionStatus @default(QUEUED)
  /// = companyId while QUEUED/RUNNING, NULL once finished: one active run per company (see ExtractionRun).
  activeKey        String?          @unique @map("active_key") @db.Uuid
  attempts         Int              @default(0)
  careerPagesFound Int              @default(0) @map("career_pages_found")
  sourcesChecked   Int              @default(0) @map("sources_checked")
  jobsFound        Int              @default(0) @map("jobs_found")
  stats            Json             @default("{}")
  errorCode        String?          @map("error_code")
  errorMessage     String?          @map("error_message")
  errors           Json             @default("[]")
  createdAt        DateTime         @default(now()) @map("created_at")
  startedAt        DateTime?        @map("started_at")
  finishedAt       DateTime?        @map("finished_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestedBy User?     @relation("JobRunRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([status, createdAt])
  @@map("job_runs")
}

model JobSource {
  id                  String           @id @default(uuid(7)) @db.Uuid
  workspaceId         String           @map("workspace_id") @db.Uuid
  companyId           String           @map("company_id") @db.Uuid
  /// greenhouse | lever | ashby | generic-html, or the name of an unsupported ATS (workable, ...).
  providerId          String           @map("provider_id")
  /// Greenhouse board token / Lever site / Ashby board name / canonical page URL (generic).
  boardKey            String           @map("board_key")
  boardUrl            String           @map("board_url")
  region              String?
  status              JobSourceStatus  @default(ACTIVE)
  /// The company page the source was discovered from, and how it was recognised.
  discoveredFromUrl   String?          @map("discovered_from_url")
  discoveryConfidence Float?           @map("discovery_confidence")
  discoveryEvidence   String?          @map("discovery_evidence")
  lastCheckedAt       DateTime?        @map("last_checked_at")
  lastSuccessAt       DateTime?        @map("last_success_at")
  lastOutcome         JobCheckOutcome? @map("last_outcome")
  consecutiveFailures Int              @default(0) @map("consecutive_failures")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobs      Job[]
  checks    JobCheck[]

  @@unique([companyId, providerId, boardKey])
  @@index([workspaceId])
  @@map("job_sources")
}

model Job {
  id             String         @id @default(uuid(7)) @db.Uuid
  workspaceId    String         @map("workspace_id") @db.Uuid
  companyId      String         @map("company_id") @db.Uuid
  sourceId       String         @map("source_id") @db.Uuid
  /// The provider's own job id (generic pages: hash of the job URL). UNIQUE per source = no duplicate imports.
  externalId     String         @map("external_id")
  /// sha1(title|primary location): detects the same vacancy listed by two sources.
  fingerprint    String
  title          String
  /// Plain text only; provider HTML is never stored.
  description    String?
  location       String?
  locations      String[]       @default([])
  department     String?
  employmentType EmploymentType @default(UNKNOWN) @map("employment_type")
  workplaceType  WorkplaceType  @default(UNKNOWN) @map("workplace_type")
  /// Exactly as the provider published it. This system never submits applications.
  applicationUrl String?        @map("application_url")
  sourceUrl      String         @map("source_url")
  publishedAt    DateTime?      @map("published_at")
  /// API | JSON_LD | MICRODATA | HTML | AI
  extraction     String
  status         JobStatus      @default(OPEN)
  firstSeenAt    DateTime       @default(now()) @map("first_seen_at")
  lastSeenAt     DateTime       @default(now()) @map("last_seen_at")
  closedAt       DateTime?      @map("closed_at")
  lastCheckId    String?        @map("last_check_id") @db.Uuid

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source    JobSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, externalId])
  @@index([companyId, status])
  @@index([companyId, fingerprint])
  @@index([workspaceId, status, firstSeenAt])
  @@map("jobs")
}

/// One fetch of one source. Failures are first-class: a FAILED/INCONCLUSIVE check is evidence of
/// "we do not know", never of "no vacancies".
model JobCheck {
  id                String          @id @default(uuid(7)) @db.Uuid
  workspaceId       String          @map("workspace_id") @db.Uuid
  companyId         String          @map("company_id") @db.Uuid
  sourceId          String          @map("source_id") @db.Uuid
  runId             String?         @map("run_id") @db.Uuid
  outcome           JobCheckOutcome
  /// The official API answered completely, so jobs it no longer lists were closed.
  authoritative     Boolean         @default(false)
  jobsFound         Int             @default(0) @map("jobs_found")
  jobsCreated       Int             @default(0) @map("jobs_created")
  jobsUpdated       Int             @default(0) @map("jobs_updated")
  jobsClosed        Int             @default(0) @map("jobs_closed")
  duplicatesSkipped Int             @default(0) @map("duplicates_skipped")
  pagesFetched      Int             @default(0) @map("pages_fetched")
  errorCode         String?         @map("error_code")
  errorMessage      String?         @map("error_message")
  retryable         Boolean?
  httpStatus        Int?            @map("http_status")
  /// NO_OPENINGS / INCONCLUSIVE: what the source said (or why nothing could be read).
  evidence          String?
  startedAt         DateTime        @default(now()) @map("started_at")
  finishedAt        DateTime?       @map("finished_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source    JobSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, startedAt])
  @@index([companyId, startedAt])
  @@map("job_checks")
}
