{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "20",
  "globalDependencies": [".env"],
  "globalPassThroughEnv": [
    "NODE_ENV",
    "LOG_LEVEL",
    "DATABASE_URL",
    "REDIS_URL",
    "WEB_ORIGIN",
    "API_*",
    "SESSION_*",
    "AUTH_*",
    "SWAGGER_ENABLED",
    "WORKER_*",
    "DISCOVERY_*",
    "BRAVE_*",
    "OVERPASS_*",
    "ENRICHMENT_*",
    "JOBS_*",
    "INTELLIGENCE_*",
    "EXPORT_*",
    "ANTHROPIC_*"
  ],
  "tasks": {
    "generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "lint": {
      "dependsOn": ["^build", "generate"]
    },
    "test": {
      "dependsOn": ["^build", "generate"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build", "generate"],
      "cache": false,
      "persistent": true
    }
  }
}
