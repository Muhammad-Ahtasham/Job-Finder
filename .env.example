# Copy to .env for local development. NEVER commit real secrets.
NODE_ENV=development
LOG_LEVEL=debug

# --- Docker Compose (infrastructure) ---
POSTGRES_USER=jobfinder
POSTGRES_PASSWORD=jobfinder_dev_password
POSTGRES_DB=jobfinder
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Shared ---
DATABASE_URL=postgresql://jobfinder:jobfinder_dev_password@localhost:5432/jobfinder?schema=public
REDIS_URL=redis://localhost:6379

# --- API ---
API_HOST=0.0.0.0
API_PORT=4000
# Browser origin(s) allowed to call state-changing endpoints (comma separated)
WEB_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=jf_session
# Use true behind HTTPS (required in production). In production prefer SESSION_COOKIE_NAME=__Host-jf_session
SESSION_COOKIE_SECURE=false
SESSION_ABSOLUTE_TTL_HOURS=168
SESSION_IDLE_TTL_HOURS=24
SESSION_ROTATE_AFTER_MINUTES=60
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Worker ---
WORKER_HEARTBEAT_INTERVAL_MS=10000

# --- Web ---
# Server-side URL Next.js uses to reach the API (rewrites + server components)
API_INTERNAL_URL=http://localhost:4000

# --- Company discovery (worker) ---
# Providers to enable: overpass-osm (no key, OSM/ODbL) and/or brave-search.
DISCOVERY_PROVIDERS=overpass-osm
# How the operator can be reached; sent in the User-Agent as OSM's policy requires.
DISCOVERY_CONTACT=
# Brave Search: only enable if your plan grants STORAGE RIGHTS (its terms bar storing results otherwise).
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_STORAGE_RIGHTS=false
BRAVE_SEARCH_RPS=1
BRAVE_SEARCH_PAGES=2
# The public Overpass instance is for light use; prefer a self-hosted one built from a Geofabrik extract.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_MIN_INTERVAL_MS=5000
DISCOVERY_RECONCILE_STALE_SECONDS=60
# Dev/demo only (refused in production): DISCOVERY_PROVIDERS=fixture-directory,fixture-map
DISCOVERY_RETRY_BASE_MS=5000
DISCOVERY_MAX_ATTEMPTS=5

# --- Company website enrichment (worker) ---
# The crawler identifies itself as JobFinderBot/<version> (+DISCOVERY_CONTACT) and obeys robots.txt.
ENRICHMENT_CONCURRENCY=2
# Minimum spacing between requests to one site (shared across worker replicas via Redis).
ENRICHMENT_DOMAIN_MIN_INTERVAL_MS=2000
ENRICHMENT_REQUEST_TIMEOUT_MS=10000
ENRICHMENT_MAX_RESPONSE_BYTES=1048576
ENRICHMENT_MAX_REQUESTS_PER_SITE=12
ENRICHMENT_MAX_ATTEMPTS=3
# Optional: AI second opinions for ambiguous page/contact classification only. Leave blank to disable.
ANTHROPIC_API_KEY=
ENRICHMENT_AI_MODEL=claude-haiku-5-5

# --- Career pages and job providers (worker) ---
# Greenhouse, Lever and Ashby are read through their public APIs; other career pages are parsed from HTML.
JOBS_CONCURRENCY=2
JOBS_API_MIN_INTERVAL_MS=1000
JOBS_MAX_CAREER_FETCHES=6
JOBS_MAX_ATTEMPTS=3

# --- Job intelligence and matching (worker) ---
# Skill extraction, role classification and semantic matching use ANTHROPIC_API_KEY when set;
# without it everything runs on deterministic rules. Set INTELLIGENCE_AI_ENABLED=false to force rules.
INTELLIGENCE_AI_ENABLED=true
INTELLIGENCE_AI_MODEL=claude-haiku-5-5
INTELLIGENCE_BATCH_SIZE=25
INTELLIGENCE_CONCURRENCY=2
# An OPEN job not confirmed by any check for this long becomes UNKNOWN (never CLOSED).
JOBS_STALE_AFTER_DAYS=14
